# Clé API OpenAI pour le Coach IA (Pro)
# Laisse vide ou "sk-ta-clé-ici" pour utiliser le mode démo
EXPO_PUBLIC_OPENAI_KEY=sk-ta-clé-ici

# IDs d'unité bannière AdMob (production).
# Laisse vide en dev : l'app retombe automatiquement sur les IDs de test Google.
# Renseigne les vraies unités avant un build store (une par plateforme).
EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
